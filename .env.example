# Výchozí produkční doména je rovněž nastavená v astro.config.mjs.
SITE_URL=https://raccoonracing.cz

# Produkční build indexaci povoluje. Pro staging nastavte false a znovu sestavte.
# Vývojový server je vždy noindex.
INDEXING_ENABLED=true

# Volitelný ověřovací kód ze služby Google Search Console (HTML tag).
# GOOGLE_SITE_VERIFICATION=
