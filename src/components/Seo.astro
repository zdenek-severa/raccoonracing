---
import { contacts } from '../data/content';

const title = 'Raccoon Racing | Chovná stanice australského honáckého psa';
const description = 'Poznejte Raccoon Racing, chovnou stanici australského honáckého psa. Naši psi, povaha plemene, informace o štěňatech a kontakt na Zdeňka a Petru.';
const canonical = Astro.site ? new URL('/', Astro.site).href : undefined;
const indexable = import.meta.env.PROD && import.meta.env.INDEXING_ENABLED !== 'false' && !!canonical;
const image = Astro.site ? new URL('/images/social-card.jpg', Astro.site).href : undefined;
const verification = import.meta.env.GOOGLE_SITE_VERIFICATION;
const schema = canonical ? {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization', '@id': `${canonical}#organization`,
      name: 'Raccoon Racing', url: canonical,
      description, image,
      logo: new URL('/favicon.svg', canonical).href,
      contactPoint: contacts.map(contact => ({
        '@type': 'ContactPoint', name: contact.name,
        telephone: contact.tel, email: contact.email, availableLanguage: 'cs',
        contactType: 'Informace o chovné stanici',
      })),
    },
    {
      '@type': 'WebSite', '@id': `${canonical}#website`,
      url: canonical, name: 'Raccoon Racing', inLanguage: 'cs-CZ',
      publisher: { '@id': `${canonical}#organization` },
    },
    {
      '@type': 'WebPage', '@id': `${canonical}#webpage`,
      url: canonical, name: title, description, inLanguage: 'cs-CZ',
      isPartOf: { '@id': `${canonical}#website` },
      about: { '@id': `${canonical}#organization` },
      primaryImageOfPage: { '@type': 'ImageObject', url: image, width: 1200, height: 630 },
    },
  ],
} : undefined;
---
<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={indexable ? 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1' : 'noindex, follow'} />
{canonical && <link rel="canonical" href={canonical} />}
<meta property="og:site_name" content="Raccoon Racing" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:locale" content="cs_CZ" />
{canonical && <meta property="og:url" content={canonical} />}
{image && <>
  <meta property="og:image" content={image} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:type" content="image/jpeg" />
  <meta property="og:image:alt" content="Aki — australský honácký pes stanice Raccoon Racing" />
</>}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{image && <meta name="twitter:image" content={image} />}
<meta name="twitter:image:alt" content="Aki — australský honácký pes stanice Raccoon Racing" />
{verification && <meta name="google-site-verification" content={verification} />}
{schema && <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\u003c')} />}
