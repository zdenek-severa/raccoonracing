---
import '../styles/global.css';
import Navigation from '../components/Navigation';
import DogProfile from '../components/DogProfile';
import Faq from '../components/Faq';
import Gallery from '../components/Gallery';
import { contacts } from '../data/content';
import Seo from '../components/Seo.astro';

const principles = [
  ['01', 'Povaha na prvním místě', 'Za krásným exteriérem hledáme především vnímavého parťáka. Zajímá nás vztah, ochota spolupracovat a společný život v každodenních situacích.'],
  ['02', 'Respekt k plemeni', 'Honácký pes má vlastní hlavu a velké pracovní srdce. Chceme jeho přirozené vlohy poznávat, rozvíjet a dávat jim smysluplné využití.'],
  ['03', 'Otevřeně a osobně', 'Na dobrém začátku záleží. O psech, zdraví i očekáváních mluvíme na rovinu. Rádi se poznáme dřív, než uděláte tak důležité rozhodnutí.'],
];
---
<!doctype html>
<html lang="cs">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#251c17" />
    <Seo />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <a href="#obsah" class="skip-link">Přejít na obsah</a>
    <header class="site-header"><div class="container header-inner">
      <a href="#" class="brand" aria-label="Raccoon Racing — úvod"><svg class="brand-mark" viewBox="0 0 48 48" fill="none" aria-hidden="true"><path d="m8 18 1-12 12 7h6l12-7 1 12 4 10-9 13-11 4-11-4L4 28Z" stroke="currentColor" stroke-width="1.6"/><path d="m8 25 11-4 5 5 5-5 11 4-6 9-10-3-10 3Z" fill="currentColor"/><path d="m20 36 4 4 4-4" stroke="currentColor" stroke-width="1.6"/><path d="m14 26 4 1m12 0 4-1" stroke="#251c17" stroke-width="2.5"/></svg><span>RACCOON RACING<small>AUSTRALIAN CATTLE DOG</small></span></a>
      <Navigation client:load />
    </div></header>
    <main id="obsah">
      <section class="hero" aria-labelledby="hero-heading">
        <div class="hero-image"><img src="/images/aki-hero.webp" alt="Aki, australský honácký pes, ve zlatém světle" width="1100" height="1669" fetchpriority="high" /></div>
        <div class="hero-shade"></div>
        <div class="container hero-content"><p class="eyebrow"><span class="little-line"></span> CHOVNÁ STANICE · AUSTRALSKÝ HONÁCKÝ PES</p><h1 id="hero-heading">Malý kus Austrálie.<br />Velký kus <em>srdce.</em></h1><p class="hero-description">Energie do každého dobrodružství.<br />Věrnost na celý život. To je náš honák.</p><div class="hero-actions"><a class="button button-gold" href="#nasi-psi">Poznejte naši smečku <span aria-hidden="true">↗</span></a><a class="text-link" href="#o-nas">Náš příběh <span aria-hidden="true">→</span></a></div></div>
        <div class="container hero-bottom"><a href="#o-nas" class="scroll-cue"><span aria-hidden="true">↓</span> O KOUSEK BLÍŽ K NÁM</a><div class="hero-caption"><span>SEZNAMTE SE, TOHLE JE</span><strong>Aki</strong><small>Akarni Flameborn Linden Algona</small></div></div>
      </section>
      <div class="values-strip"><div class="container flex flex-wrap items-center justify-between gap-5"><span>AUSTRALSKÝ HONÁCKÝ PES</span><i aria-hidden="true">✦</i><span>SRDCEM PARŤÁK</span><i aria-hidden="true">✦</i><span>DUŠÍ DOBRODRUH</span><i aria-hidden="true">✦</i><span>RACCOON RACING</span></div></div>
      <section id="o-nas" class="section about-section"><div class="container">
        <div class="section-intro"><div><p class="eyebrow text-copper">01 / NÁŠ PŘÍBĚH</p><h2>Život je lepší<br />se stopami <em>tlapek.</em></h2></div><div class="intro-copy"><p class="lead">Jsme Raccoon Racing. Za tímhle jménem stojí Zdeněk a Petra — a slabost pro psy, kteří do všeho dávají celé srdce.</p><p>Australský honácký pes nás oslovuje svou osobností. Je chytrý, oddaný a připravený být součástí skutečného života. Na cestách, při práci i ve chvílích, kdy prostě jen jsme spolu.</p><p>Naši stanici chceme stavět na respektu ke psům i lidem. Na vztahu, který se nepočítá na medaile, ale na společně prožitý čas.</p><a class="underlined-link" href="#kontakt">Rádi vás poznáme <span aria-hidden="true">↗</span></a></div></div>
        <div class="principles">{principles.map(([number, title, text]) => <article><span class="principle-number">{number}</span><h3>{title}</h3><p>{text}</p></article>)}</div>
      </div></section>
      <section id="nasi-psi" class="section dog-section"><div class="container dog-layout"><div class="dog-visual"><img src="/images/aki-standing.webp" alt="Aki v postoji, červeně tečkovaný australský honácký pes" width="900" height="859" loading="lazy" /><div class="photo-label"><span>RED SPECKLE</span><span>AUSTRALIAN CATTLE DOG ↗</span></div><div class="dog-number" aria-hidden="true">01</div></div><div class="dog-copy"><p class="eyebrow text-copper">02 / NAŠI PSI</p><h2>Jedním slovem.<br /><em>Aki.</em></h2><p class="pedigree-name">Akarni Flameborn Linden Algona</p><DogProfile client:visible /><a class="underlined-link" href="/images/aki-poster.webp" target="_blank" rel="noopener">Prohlédnout prezentační plakát <span aria-hidden="true">↗</span></a></div></div></section>
      <section id="plemeno" class="section breed-section"><div class="container"><div class="breed-heading"><div><p class="eyebrow">03 / AUSTRALIAN CATTLE DOG</p><h2>Není pro každého.<br />Pro někoho je <em>vším.</em></h2></div><p>Pod nezaměnitelnou srstí se skrývá pracovitý pes, který chce mít své místo po vašem boku. Poznejte plemeno, které miluje život v pohybu.</p></div><div class="breed-grid"><article><span class="breed-icon" aria-hidden="true">↗</span><h3>Energie, která má směr</h3><p>Dlouhá procházka je začátek. Honák ocení také úkol, nové podněty a společnou aktivitu. Stejně důležité je naučit ho vypnout a odpočívat.</p></article><article><span class="breed-icon" aria-hidden="true">✧</span><h3>Hlava plná nápadů</h3><p>Rychle se učí a rád hledá vlastní řešení. Jasná pravidla, důslednost a odměna za spolupráci vám pomohou najít společnou řeč.</p></article><article><span class="breed-icon" aria-hidden="true">♡</span><h3>Vztah na celý život</h3><p>Ke svým lidem si vytváří silné pouto. Potřebuje být součástí dění a poznávat svět postupně, s oporou člověka, kterému věří.</p></article></div><div class="breed-note"><span aria-hidden="true">✦</span><p>Nejlepší výbava pro život s honákem? <strong>Čas, trpělivost a chuť dělat věci společně.</strong></p></div></div></section>
      <section id="stenata" class="section puppies-section"><div class="container puppies-layout"><div><p class="eyebrow text-copper">04 / ŠTĚŇATA</p><h2>Velké přátelství.<br /><em>Malé začátky.</em></h2><p class="lead">Hledáte parťáka, který s vámi bude držet krok? Pojďme nejdřív zjistit, jestli je honák právě pro vás.</p><p>Výběr štěněte začíná rozhovorem. Zajímá nás váš běžný den, představy i to, co od psího kamaráda čekáte. A vy byste měli znát nás. Na dobrém spojení nám záleží víc než na rychlém rozhodnutí.</p><a class="button button-dark" href="#kontakt">Pojďme si o tom popovídat <span aria-hidden="true">↗</span></a></div><div class="puppy-process"><div class="availability"><span></span> INFORMACE O VRZÍCH NA DOTAZ</div><h3>Než se naše cesty spojí</h3><ol><li><span>01</span><div><h4>Napište nám svůj příběh</h4><p>Kdo jste, jak žijete a jak si představujete společný život se psem.</p></div></li><li><span>02</span><div><h4>Poznáme se osobně</h4><p>Probereme povahu plemene, vaše otázky i vzájemná očekávání.</p></div></li><li><span>03</span><div><h4>Najdeme společnou cestu</h4><p>Aktuální plány a možnosti s vámi projdeme otevřeně a bez spěchu.</p></div></li></ol><p class="small-note">Aktuální dostupnost štěňat a chovatelské plány vám rádi sdělíme osobně.</p></div></div></section>
      <section id="galerie" class="section gallery-section"><div class="container"><div class="gallery-heading"><div><p class="eyebrow text-copper">05 / GALERIE</p><h2>Tvář naší <em>smečky.</em></h2></div><p>Aki v detailech z jeho prezentačního plakátu.<br />Klikněte a podívejte se zblízka.</p></div><Gallery client:visible /></div></section>
      <section class="section faq-section"><div class="container faq-layout"><div><p class="eyebrow text-copper">JEŠTĚ VÁS MOŽNÁ ZAJÍMÁ</p><h2>Dobré otázky.<br /><em>Upřímné odpovědi.</em></h2><p>Žádná otázka není malá, když vybíráte parťáka na spoustu let.</p></div><Faq client:visible /></div></section>
      <section id="kontakt" class="section contact-section"><div class="contact-landscape" aria-hidden="true"></div><div class="container relative"><p class="eyebrow">06 / KONTAKT</p><div class="contact-heading"><h2>Každý příběh začíná<br />jedním <em>ahoj.</em></h2><p>Chcete poznat naši smečku, zeptat se na plemeno nebo probrat své plány? Ozvěte se. Rádi si na vás najdeme čas.</p></div><div class="contacts">{contacts.map((contact, i) => <article><span class="contact-number">0{i + 1}</span><div><h3>{contact.name}</h3><a href={`tel:${contact.tel}`}>{contact.phone.replaceAll(' ', String.fromCharCode(160))} <span aria-hidden="true">↗</span></a><a class="email" href={`mailto:${contact.email}`}>{contact.email} <span aria-hidden="true">↗</span></a></div></article>)}</div><div class="contact-footnote"><span>NÁVŠTĚVA PO PŘEDCHOZÍ DOMLUVĚ</span><span>TĚŠÍME SE NA VÁS. A NA VAŠE PŘÍBĚHY.</span></div></div></section>
    </main>
    <footer><div class="container footer-inner"><a class="footer-brand" href="#">RACCOON RACING<small>AUSTRALIAN CATTLE DOG</small></a><p>© {new Date().getFullYear()} Raccoon Racing<br /><span>S láskou k plemeni. S respektem k životu.</span></p><a class="back-top" href="#">Zpátky na začátek <span aria-hidden="true">↑</span></a></div></footer>
  </body>
</html>
