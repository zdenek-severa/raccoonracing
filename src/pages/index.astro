---
import '../styles/global.css';
import Navigation from '../components/Navigation';
import DogProfile from '../components/DogProfile';
import Faq from '../components/Faq';
import Gallery from '../components/Gallery';
import Seo from '../components/Seo.astro';

const moments = [
  ['01', 'Dvě jména, dva příběhy', 'Aki a Adi. Stejné plemeno, ale každý má na těchto stránkách své místo. Baví nás poznávat psa jako osobnost, se vším, co k němu patří.'],
  ['02', 'Společně je to ono', 'Psí život pro nás tvoří malé věci: čas venku, společná řeč a chvíle, kdy se nemusí vůbec nic. Právě z nich vzniká vztah člověka a psa.'],
  ['03', 'Vzpomínky místo spěchu', 'Tenhle web je náš prostor pro psí příběhy a fotografie. Pro radost z plemene i obyčejných okamžiků, které bychom si rádi uchovali.'],
];
---
<!doctype html>
<html lang="cs">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#251c17" />
    <Seo />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <a href="#obsah" class="skip-link">Přejít na obsah</a>
    <header class="site-header">
      <div class="container header-inner">
        <a href="#" class="brand" aria-label="Raccoon Racing — Aki a Adi, úvod">
          <svg class="brand-mark" viewBox="0 0 48 48" fill="none" aria-hidden="true"><path d="m8 18 1-12 12 7h6l12-7 1 12 4 10-9 13-11 4-11-4L4 28Z" stroke="currentColor" stroke-width="1.6"/><path d="m8 25 11-4 5 5 5-5 11 4-6 9-10-3-10 3Z" fill="currentColor"/><path d="m20 36 4 4 4-4" stroke="currentColor" stroke-width="1.6"/><path d="m14 26 4 1m12 0 4-1" stroke="#251c17" stroke-width="2.5"/></svg>
          <span>RACCOON RACING<small>AKI &amp; ADI · AUSTRALIAN CATTLE DOGS</small></span>
        </a>
        <Navigation client:load />
      </div>
    </header>
    <main id="obsah">
      <section class="hero" aria-labelledby="hero-heading">
        <div class="hero-image"><img src="/images/aki-hero.webp" alt="Aki, australský honácký pes, ve zlatém světle" width="1100" height="1669" fetchpriority="high" /></div>
        <div class="hero-shade"></div>
        <div class="container hero-content">
          <p class="eyebrow"><span class="little-line"></span> OSOBNÍ STRÁNKY · DVA AUSTRALŠTÍ HONÁCI</p>
          <h1 id="hero-heading">Aki &amp; Adi.<br />Naše psí <em>srdcovky.</em></h1>
          <p class="hero-description">Pes Aki a fenka Adi.<br />Dva australští honáci a náš společný svět.</p>
          <div class="hero-actions"><a class="button button-gold" href="#nasi-psi">Seznamte se s Akim a Adi <span aria-hidden="true">↗</span></a><a class="text-link" href="#o-nas">Vítejte u nás <span aria-hidden="true">→</span></a></div>
        </div>
        <div class="container hero-bottom"><a href="#o-nas" class="scroll-cue"><span aria-hidden="true">↓</span> DÁL PO NAŠICH STOPÁCH</a><div class="hero-caption"><span>NA ÚVODNÍ FOTOGRAFII</span><strong>Aki</strong><small>Akarni Flameborn Linden Algona</small></div></div>
      </section>
      <div class="values-strip"><div class="container flex flex-wrap items-center justify-between gap-5"><span>AKI &amp; ADI</span><i aria-hidden="true">✦</i><span>AUSTRALŠTÍ HONÁCI</span><i aria-hidden="true">✦</i><span>NÁŠ PSÍ SVĚT</span><i aria-hidden="true">✦</i><span>RACCOON RACING</span></div></div>

      <section id="o-nas" class="section about-section">
        <div class="container">
          <div class="section-intro"><div><p class="eyebrow text-copper">01 / VÍTEJTE V NAŠEM SVĚTĚ</p><h2>Dvě jména.<br />Spousta místa <em>v srdci.</em></h2></div><div class="intro-copy"><p class="lead">Tohle jsou osobní stránky Akiho a Adi. On je pes, ona fenka. Oba jsou australští honáčtí psi a oba patří do našeho života.</p><p>Raccoon Racing je kousek internetu věnovaný téhle psí dvojici. Místo, kde se s Akim a Adi můžete seznámit a nahlédnout do světa jejich plemene.</p><p>Najdete tu Akiho profil, představení Adi, fotografie i pár slov o tom, co pro nás znamená život se psy. Každý příběh má své hrdiny. Ti naši mají čtyři tlapky.</p><a class="underlined-link" href="#nasi-psi">Poznejte hlavní hrdiny <span aria-hidden="true">↗</span></a></div></div>
          <div class="principles">{moments.map(([number, title, text]) => <article><span class="principle-number">{number}</span><h3>{title}</h3><p>{text}</p></article>)}</div>
        </div>
      </section>

      <section id="nasi-psi" class="section dog-section" aria-labelledby="aki-heading">
        <div id="aki" class="container dog-layout">
          <div class="dog-visual"><img src="/images/aki-standing.webp" alt="Aki, červeně tečkovaný australský honácký pes, v postoji" width="900" height="859" loading="lazy" /><div class="photo-label"><span>AKI · PES</span><span>AUSTRALIAN CATTLE DOG ↗</span></div><div class="dog-number" aria-hidden="true">01</div></div>
          <div class="dog-copy"><p class="eyebrow text-copper">02 / SEZNAMTE SE S AKIM</p><h2 id="aki-heading">Seznamte se.<br />Tohle je <em>Aki.</em></h2><p class="pedigree-name">Akarni Flameborn Linden Algona</p><DogProfile client:visible /><a class="underlined-link" href="/images/aki-poster.webp" target="_blank" rel="noopener">Akiho portréty a údaje na jednom plakátu <span aria-hidden="true">↗</span></a></div>
        </div>
      </section>

      <section id="adi" class="section adi-section" aria-labelledby="adi-heading">
        <div class="container dog-layout">
          <div class="dog-copy"><p class="eyebrow text-copper">03 / SEZNAMTE SE S ADI</p><h2 id="adi-heading">Druhé jméno.<br />Další <em>srdcovka.</em></h2><p class="pedigree-name">Adi · fenka australského honáckého psa</p><p class="lead">K Akimu patří na těchto stránkách také Adi. Naše fenka stejného plemene a druhá hlavní postava Raccoon Racing.</p><p>Každý pes má svůj příběh. A tak má i Adi své vlastní místo — vedle Akiho, ale sama za sebe. Dvě osobnosti, které spojuje jedno plemeno a lidé kolem nich.</p><dl class="profile-facts adi-facts"><div><dt>Jméno</dt><dd>Adi</dd></div><div><dt>Pohlaví</dt><dd>Fenka</dd></div><div><dt>Plemeno</dt><dd>Australský honácký pes</dd></div></dl><a class="underlined-link" href="#spolecne">Náš společný svět <span aria-hidden="true">↗</span></a></div>
          <div class="adi-nameplate"><span class="adi-nameplate-label">DRUHÁ POLOVINA NAŠÍ SMEČKY</span><svg class="adi-paw" viewBox="0 0 140 140" fill="none" aria-hidden="true"><ellipse cx="40" cy="42" rx="12" ry="18" transform="rotate(-25 40 42)"/><ellipse cx="65" cy="30" rx="12" ry="18" transform="rotate(-8 65 30)"/><ellipse cx="91" cy="35" rx="12" ry="18" transform="rotate(16 91 35)"/><ellipse cx="110" cy="56" rx="11" ry="17" transform="rotate(35 110 56)"/><path d="M35 92c0-11 14-22 20-32 7-12 22-12 28 0 7 12 23 22 23 35 0 12-12 19-24 14-10-4-15-4-25 0-12 5-22-3-22-17Z"/></svg><span class="adi-name">Adi<span aria-hidden="true">♀</span></span><span class="adi-nameplate-breed">AUSTRALIAN CATTLE DOG</span><span class="adi-nameplate-foot">AKI &amp; ADI · RACCOON RACING</span></div>
        </div>
      </section>

      <section id="plemeno" class="section breed-section">
        <div class="container"><div class="breed-heading"><div><p class="eyebrow">04 / PLEMENO, KTERÉ NÁS SPOJUJE</p><h2>Australský honák.<br />Pes s vlastní <em>hlavou.</em></h2></div><p>Aki a Adi jsou australští honáčtí psi, známí také jako Australian Cattle Dogs. Na tomhle plemeni nás baví jeho vnímavost, pracovní kořeny a vztah k člověku.</p></div><div class="breed-grid"><article><span class="breed-icon" aria-hidden="true">↗</span><h3>Pracovní kořeny</h3><p>Za jménem plemene stojí práce s dobytkem. Vytrvalost a chuť něco dělat k jeho příběhu patří dodnes. Pohyb má pro honáka největší smysl, když ho sdílí se svým člověkem.</p></article><article><span class="breed-icon" aria-hidden="true">✧</span><h3>Bystrá hlava</h3><p>Honák se dokáže rychle učit a přicházet s vlastními nápady. Na společném soužití nás zajímá právě hledání vzájemného porozumění — po malých krocích, s časem a trpělivostí.</p></article><article><span class="breed-icon" aria-hidden="true">♡</span><h3>Každý je svůj</h3><p>Plemeno je společný základ. Konkrétní pes je ale vždycky osobnost. Proto tu představujeme zvlášť Akiho i Adi a necháváme prostor příběhu každého z nich.</p></article></div><div class="breed-note"><span aria-hidden="true">✦</span><p>Co máme na psech nejraději? <strong>Že s každým vzniká úplně jiný, vlastní vztah.</strong></p></div></div>
      </section>

      <section id="spolecne" class="section life-section">
        <div class="container life-layout"><div><p class="eyebrow text-copper">05 / ŽIVOT S HONÁKY</p><h2>Nejhezčí příběhy<br />začínají <em>společně.</em></h2><p class="lead">Velké zážitky mají své místo. Stejně tak ale i obyčejný den, ve kterém je čas na psa a pes má místo vedle člověka.</p><p>Právě tak chceme vyprávět o Akim a Adi. Přes malé okamžiky, fotografie a radost z toho, že psi jsou součástí našeho světa. Bez potřeby dělat z každého dne výjimečnou událost.</p><a class="button button-dark" href="#galerie">Nahlédněte do fotogalerie <span aria-hidden="true">↗</span></a></div><div class="life-notes"><p class="eyebrow text-copper">NA ČEM NÁM ZÁLEŽÍ</p><h3>Malé věci, velký význam</h3><ol><li><span>01</span><div><h4>Čas pro sebe navzájem</h4><p>Být spolu, vnímat se a najít si každý den chvíli, která patří jen nám a psům.</p></div></li><li><span>02</span><div><h4>Prostor být psem</h4><p>Prozkoumávat, učit se i odpočívat. Objevovat, co vyhovuje každému zvlášť.</p></div></li><li><span>03</span><div><h4>Vzpomínky, ke kterým se vracíme</h4><p>Jedna fotografie někdy připomene celý příběh. Tady pro ně máme místo.</p></div></li></ol><p class="small-note">Aki a Adi. Dvě psí jména, která patří k našemu životu.</p></div></div>
      </section>

      <section id="galerie" class="section gallery-section"><div class="container"><div class="gallery-heading"><div><p class="eyebrow text-copper">06 / FOTOGALERIE</p><h2>Aki <em>zblízka.</em></h2></div><p>Portrét, postoj a Akiho plakát.<br />Klikněte na obrázek a prohlédněte si detaily.</p></div><Gallery client:visible /></div></section>
      <section class="section faq-section"><div class="container faq-layout"><div><p class="eyebrow text-copper">CO VÁS MOŽNÁ ZAJÍMÁ</p><h2>Ještě pár slov<br /><em>o naší smečce.</em></h2><p>O Akim, Adi a stránkách, které jsme jim věnovali.</p></div><Faq client:visible /></div></section>
    </main>
    <footer><div class="container footer-inner"><a class="footer-brand" href="#">RACCOON RACING<small>AKI &amp; ADI · AUSTRALIAN CATTLE DOGS</small></a><p>© {new Date().getFullYear()} Raccoon Racing<br /><span>Osobní stránky Akiho a Adi. Srdcem u honáků.</span></p><a class="back-top" href="#">Zpátky za Akim a Adi <span aria-hidden="true">↑</span></a></div></footer>
  </body>
</html>
